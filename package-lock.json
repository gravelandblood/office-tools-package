{
  "name": "office-tools-package-workspace",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "office-tools-package-workspace",
      "version": "0.1.0",
      "license": "MIT",
      "workspaces": [
        "packages/*"
      ]
    },
    "node_modules/@office-tools/backend-officecli": {
      "resolved": "packages/backend-officecli",
      "link": true
    },
    "node_modules/@office-tools/backend-wps-jsapi": {
      "resolved": "packages/backend-wps-jsapi",
      "link": true
    },
    "node_modules/@office-tools/backend-wps-uia": {
      "resolved": "packages/backend-wps-uia",
      "link": true
    },
    "node_modules/@office-tools/cli": {
      "resolved": "packages/cli",
      "link": true
    },
    "packages/backend-officecli": {
      "name": "@office-tools/backend-officecli",
      "version": "0.1.0",
      "license": "MIT"
    },
    "packages/backend-wps-jsapi": {
      "name": "@office-tools/backend-wps-jsapi",
      "version": "0.1.0",
      "license": "MIT"
    },
    "packages/backend-wps-uia": {
      "name": "@office-tools/backend-wps-uia",
      "version": "0.1.0",
      "license": "MIT"
    },
    "packages/cli": {
      "name": "@office-tools/cli",
      "version": "0.1.0",
      "license": "MIT",
      "dependencies": {
        "@office-tools/backend-officecli": "0.1.0",
        "@office-tools/backend-wps-jsapi": "0.1.0",
        "@office-tools/backend-wps-uia": "0.1.0"
      },
      "bin": {
        "office-tools": "bin/office-tools.js"
      }
    }
  }
}
